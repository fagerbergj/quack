# Copy to .env and fill in. Used by docker-compose and local runs.

# OpenAI-compatible inference endpoint (e.g. local llama-swap).
QUACK_LLM_ENDPOINT=http://jason-server:11436/v1
QUACK_LLM_API_KEY=unused
# A thinking + tool-calling model so the chat shows reasoning + tool blocks.
QUACK_ORCH_MODEL=qwen3.6-35b
# Model the web-researcher agent runs on (tool-calling capable).
QUACK_RESEARCHER_MODEL=qwen3.6-35b
# Independent judge model for the trust gate. Best as a separate model (the
# milestone names gemma4-26b-a4b); falls back to the researcher model for local dev.
# Leave empty to disable adversarial vetting entirely.
QUACK_JUDGE_MODEL=gemma4-26b-a4b

# The web-researcher's tool backends (keyless). Defaults point at the compose
# services; override to use existing instances (e.g. on a home server).
QUACK_SEARXNG_URL=http://searxng:8080
QUACK_CRAWL4AI_URL=http://crawl4ai:11235

# Postgres DSN for the relational store.
# In docker-compose the host is `db`; for a bare local run use localhost.
QUACK_DATABASE_URL=postgres://quack:quack@localhost:5432/quack?sslmode=disable

# Semantic memory (M6). Qdrant gRPC address; in docker-compose the host is
# `qdrant`. Leave empty to disable memory entirely.
QUACK_QDRANT_URL=qdrant:6334
# Embedding model, served by the always-warm qwen3-embed group.
QUACK_EMBED_MODEL=qwen3-embed
# Personal memory about the user is off by default for privacy. To enable it,
# bind the commit_memory tool to the orchestrator in config/quack.yaml
# (orchestrator.tools: [commit_memory]) — there is no env toggle.
