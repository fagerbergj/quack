# Build artifacts
node_modules
frontend/dist
/quack
.test/
# Embedded SPA is built into internal/serve/web/dist by `make build`. Ignore
# the build output; only the .gitkeep placeholder is tracked so a fresh `go
# build` (without building the frontend) still satisfies //go:embed.
/internal/serve/web/dist/*
!/internal/serve/web/dist/.gitkeep
*.db
*.log
*.swp
*~

# Local env (secrets)
.env

# Local-only scratch: design specs, notes, throwaway configs (never committed)
.quack/

# IDE
.idea
.vscode

# Note: generated code (internal/schema/*.gen.go, frontend/src/generated/) is
# committed on purpose so the codegen-drift CI check can diff against it.

# Storybook build output
storybook-static
