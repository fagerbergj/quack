{
  "name": "@quack/runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "validate": "node src/validate.ts"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.5.0",
    "@quack/contracts": "*",
    "@quack/github": "*",
    "@quack/home": "*",
    "@quack/judge": "*",
    "@quack/remarkable": "*",
    "@quack/research": "*",
    "@quack/schedules": "*",
    "@quack/sdk": "*",
    "@quack/slots": "*",
    "@quack/subagent": "*",
    "@quack/session": "*",
    "@quack/sleeper": "*",
    "@quack/traces": "*",
    "@quack/workflows": "*"
  },
  "quack": {
    "extensions": [
      "./src/extensions/coding.ts",
      "./src/extensions/codemode.ts",
      "@quack/contracts",
      "@quack/judge",
      "@quack/github",
      "@quack/home",
      "@quack/research",
      "@quack/workflows",
      "@quack/sleeper",
      "@quack/remarkable",
      "@quack/schedules",
      "@quack/slots",
      "@quack/subagent",
      "@quack/traces"
    ]
  },
  "exports": {
    ".": "./src/session-env.ts",
    "./catalog": "./src/catalog.ts"
  }
}
