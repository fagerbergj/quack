{
  "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
  "name": "github",
  "version": "0.0.0",
  "description": "Test fixture shaped like extensions/github/plugin: three module-gated ACP code agents.",
  "extensions": {
    "io.github.fagerbergj.quack": {
      "schemaVersion": 1,
      "modules": [
        {
          "name": "github",
          "path": "github.com/fagerbergj/quack/extensions/github"
        }
      ],
      "config": "required",
      "agents": [
        "code-implementer",
        "code-reviewer",
        "code-explorer"
      ]
    }
  }
}
