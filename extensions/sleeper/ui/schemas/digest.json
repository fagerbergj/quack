{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quack.example/sleeper/ui/schemas/digest.json",
  "title": "digest",
  "description": "Weekly preview (before games) or recap (after), with every league matchup.",
  "type": "object",
  "properties": {
    "week": {
      "type": "integer"
    },
    "past": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "maxLength": 1000,
      "description": "One headline paragraph."
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "home",
          "away",
          "home_pts",
          "away_pts"
        ],
        "properties": {
          "home": {
            "type": "string",
            "maxLength": 60
          },
          "away": {
            "type": "string",
            "maxLength": 60
          },
          "home_pts": {
            "type": "number",
            "description": "Actual points for a recap; the team's 3-week recent_avg for a preview, never a projection."
          },
          "away_pts": {
            "type": "number",
            "description": "Actual points for a recap; the team's 3-week recent_avg for a preview, never a projection."
          },
          "margin": {
            "type": "number"
          },
          "mine": {
            "type": "boolean",
            "description": "Not trusted by the renderer: the owner's own game is matched by team name against /api/season's me block instead, since this agent-written flag has marked the wrong game in prod."
          },
          "top_scorers": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "source_note": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "week",
    "past",
    "games"
  ]
}
