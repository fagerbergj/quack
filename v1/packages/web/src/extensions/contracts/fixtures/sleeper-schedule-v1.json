{
  "kind": "rest",
  "title": "Sleeper schedule endpoint",
  "version": 1,
  "intent": {
    "purpose": "Gives the Sleeper page this league's upcoming runs and Sleeper's live week. Never starts a job.",
    "nonGoals": [
      "Starting or cancelling a job"
    ],
    "audience": "The Sleeper page",
    "consumers": [
      "Sleeper page"
    ],
    "guarantees": [
      "Read-only",
      "Covers a week with no runs",
      "Follows the REST guide"
    ]
  },
  "document": {
    "openapi": "3.1.0",
    "info": {
      "title": "Sleeper schedule endpoint",
      "version": "1.0.0"
    },
    "paths": {
      "/apps/sleeper/schedule": {
        "get": {
          "summary": "This league's upcoming runs and Sleeper's live week, for the Sleeper page's week strip. Never starts a job.",
          "tags": [
            "Schedule"
          ],
          "security": [
            {
              "appProxyToken": []
            }
          ],
          "parameters": [],
          "responses": {
            "200": {
              "description": "The week and its runs",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [
                      "week",
                      "runs"
                    ],
                    "properties": {
                      "week": {
                        "type": "integer",
                        "minimum": 1,
                        "example": 9,
                        "description": "Sleeper's live week, even when nothing has run yet"
                      },
                      "runs": {
                        "type": "array",
                        "description": "Upcoming runs, soonest first",
                        "items": {
                          "type": "object",
                          "required": [
                            "job",
                            "at"
                          ],
                          "properties": {
                            "job": {
                              "type": "string",
                              "enum": [
                                "lineup",
                                "waivers",
                                "trends",
                                "digest",
                                "retro",
                                "trade-finder"
                              ],
                              "description": "Which job runs"
                            },
                            "at": {
                              "type": "string",
                              "format": "date-time",
                              "description": "When it runs"
                            }
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "week": 9,
                    "runs": [
                      {
                        "job": "digest",
                        "at": "2026-11-03T06:15:00Z"
                      },
                      {
                        "job": "waivers",
                        "at": "2026-11-03T20:00:00Z"
                      }
                    ]
                  }
                }
              }
            },
            "502": {
              "description": "Sleeper service down, from the proxy"
            },
            "503": {
              "description": "Schedules service unreachable"
            }
          }
        }
      }
    },
    "components": {
      "securitySchemes": {
        "appProxyToken": {
          "type": "http",
          "scheme": "bearer",
          "description": "Service token, added by the app proxy"
        }
      }
    }
  },
  "choices": [
    {
      "id": "read-only",
      "pointer": "/paths/~1apps~1sleeper~1schedule/get",
      "decision": "GET with no body",
      "why": [
        {
          "source": "answer",
          "text": "No, it only reads",
          "ref": "Should this ever start a job?"
        },
        {
          "source": "guide",
          "text": "A read that changes nothing is a GET",
          "ref": "REST guide, methods"
        }
      ]
    },
    {
      "id": "auth",
      "pointer": "/paths/~1apps~1sleeper~1schedule/get/security",
      "decision": "Service token, added by the app proxy",
      "why": [
        {
          "source": "code",
          "text": "Every Sleeper route reaches the service through the app proxy, which adds the token",
          "ref": "v1/packages/web/src/extensions/sleeper/api.ts:14"
        },
        {
          "source": "guide",
          "text": "Callers never hold the service token",
          "ref": "REST guide, auth"
        }
      ]
    },
    {
      "id": "live-week",
      "pointer": "/paths/~1apps~1sleeper~1schedule/get/responses/200/content/application~1json/schema/properties/week",
      "decision": "Live week from Sleeper itself",
      "why": [
        {
          "source": "answer",
          "text": "Yes, always",
          "ref": "Should the week show when nothing has run yet?"
        }
      ]
    },
    {
      "id": "run-order",
      "pointer": "/paths/~1apps~1sleeper~1schedule/get/responses/200/content/application~1json/schema/properties/runs",
      "decision": "Runs soonest first",
      "why": [
        {
          "source": "answer",
          "text": "The soonest one",
          "ref": "Which run should come first?"
        }
      ]
    },
    {
      "id": "unavailable",
      "pointer": "/paths/~1apps~1sleeper~1schedule/get/responses/503",
      "decision": "503 when schedules is down",
      "why": [
        {
          "source": "answer",
          "text": "An error the page can show",
          "ref": "What should the page get when the schedules service is down?"
        },
        {
          "source": "guide",
          "text": "A dependency outage is 503 with a retry hint, not an empty success",
          "ref": "REST guide, errors"
        },
        {
          "source": "code",
          "text": "The app proxy already returns 502 when Sleeper itself is down",
          "ref": "v1/packages/distributor/src/proxy.ts:88"
        }
      ]
    }
  ]
}
