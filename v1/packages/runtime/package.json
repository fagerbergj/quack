{
  "name": "@quack/runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "validate": "node src/validate.ts"
  },
  "dependencies": {
    "@quack/github": "*",
    "@quack/home": "*",
    "@quack/index": "*",
    "@quack/judge": "*",
    "@quack/remarkable": "*",
    "@quack/research": "*",
    "@quack/sdk": "*",
    "@quack/slots": "*",
    "@quack/session": "*",
    "@quack/sleeper": "*",
    "@quack/traces": "*",
    "@quack/workflows": "*"
  },
  "quack": {
    "extensions": [
      "./src/extensions/coding.ts",
      "@quack/github",
      "@quack/home",
      "@quack/research",
      "@quack/workflows",
      "@quack/sleeper",
      "@quack/remarkable",
      "@quack/slots",
      "@quack/traces"
    ]
  },
  "exports": {
    ".": "./src/session-env.ts",
    "./catalog": "./src/catalog.ts"
  }
}
