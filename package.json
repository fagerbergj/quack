{
  "name": "quack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "postinstall": "node tools/patch-liqe.ts",
    "test": "node --test --import ./tools/leak-check.ts --test-timeout=30000 'packages/*/test/*.test.ts' 'tools/*.test.ts' && npm test -w @quack/web",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "sloplint": "node tools/sloplint.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "playwright": "1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0"
  }
}
