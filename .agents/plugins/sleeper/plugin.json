{
  "$schema": "https://agent-plugins.org/schemas/1.1.0/plugin.schema.json",
  "name": "sleeper",
  "version": "0.1.0",
  "description": "Fantasy-football decision skills (start/sit, waivers, injury and news) for the Sleeper extension's agents.",
  "license": "MIT",
  "repository": "https://github.com/fagerbergj/quack-extensions",
  "keywords": ["quack", "sleeper", "fantasy-football"],
  "extensions": {
    "io.github.fagerbergj.quack": {
      "schemaVersion": 1,
      "modules": [
        {
          "name": "sleeper",
          "path": "github.com/fagerbergj/quack-extensions/sleeper"
        }
      ],
      "config": "optional",
      "agents": ["lineup-analyst", "waiver-scout", "trend-scout"],
      "workflows": ["sleeper-lineup", "sleeper-waivers", "sleeper-trends", "sleeper-season-notes"]
    }
  }
}
