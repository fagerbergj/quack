{
  "plugins": ["typescript", "unicorn", "import", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.claude/**",
    "**/.lintdec/**",
    "**/.quack/**"
  ]
}
